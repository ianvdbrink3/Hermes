# Hermes production connection. Dedicated profile gateways use direct /v1, /health and /api paths.
HERMES_MOCK_MODE=true
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-me

# Leave empty for a dedicated production gateway. For an explicit multiplex gateway only,
# set e.g. HERMES_PATH_PREFIX=/p/his-production
HERMES_PATH_PREFIX=

# Stable memory scope for the production web OS.
HERMES_SESSION_KEY=agent:investment:webos:primary

# Brain Studio profile isolation.
# Research/builder are NOT CONFIGURED unless a BASE_URL or PATH_PREFIX is explicit AND that profile has its own API key.
# A multiplex gateway may reuse HERMES_BASE_URL as the network origin, but named profile prefixes still require their profile-specific API_SERVER_KEY values.
HERMES_RESEARCH_BASE_URL=
HERMES_RESEARCH_API_KEY=
HERMES_RESEARCH_PATH_PREFIX=
HERMES_RESEARCH_SESSION_KEY=agent:investment:brain:research

HERMES_BUILDER_BASE_URL=
HERMES_BUILDER_API_KEY=
HERMES_BUILDER_PATH_PREFIX=
HERMES_BUILDER_SESSION_KEY=agent:investment:brain:builder

# Owner authentication for the Vercel control plane.
# Use a strong password and a random secret of at least 32 characters.
OS_ACCESS_PASSWORD=replace-with-a-strong-password
OS_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional external execution-control service.
# Never point the browser directly at LYNX/TWS.
EXECUTION_CONTROL_URL=
EXECUTION_CONTROL_KEY=
